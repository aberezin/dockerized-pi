{
  "lastChangelogVersion": "0.76.0",
  "theme": "nightowl",
  "defaultProvider": "anthropic",
  "defaultModel": "claude-opus-4-7",
  "defaultThinkingLevel": "high",
  "hideThinkingBlock": true,
  "shellPath": "/bin/zsh",
  "shellCommandPrefix": "setopt aliases\nsource ~/.zshrc",
  "images": {
    "autoResize": true
  },
  "editorPaddingX": 0,
  "collapseChangelog": true,
  "enabledModels": [
    "xAI/grok-4.3",
    "xAI/grok-4-1-fast-reasoning",
    "xAI/grok-build-0.1",
    "anthropic/claude-opus-4-7",
    "kilo-code/deepseek/deepseek-v4-flash",
    "kilo-code/poolside/laguna-m.1:free",
    "kilo-code/nvidia/nemotron-3-super-120b-a12b",
    "kilo-code/stepfun/step-3.5-flash",
    "kilo-code/nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free",
    "kilo-code/poolside/laguna-xs.2:free",
    "kilo-code/kilo-auto/free",
    "kilo-code/openrouter/free"
  ],
  "packages": [
    {
      "source": "git:github.com/mitsuhiko/agent-stuff",
      "extensions": [
        "-extensions/files.ts",
        "-extensions/loop.ts",
        "-extensions/go-to-bed.ts"
      ],
      "skills": [
        "-skills/web-browser/SKILL.md",
        "-skills/openscad/SKILL.md",
        "-skills/apple-mail/SKILL.md"
      ],
      "themes": [
        "+themes/modern-dark.json",
        "+themes/nightowl.json"
      ]
    },
    "git:github.com/lucasmeijer/pi-terminal-signals"
  ],
  "terminal": {
    "showTerminalProgress": true
  },
  "doubleEscapeAction": "tree",
  "treeFilterMode": "user-only",
  "warnings": {
    "anthropicExtraUsage": true
  }
}